# HakiOS fragment: the POCO X5 Pro 5G (redwood, devices/redwood) -- what is true of this phone and of no other with the same SoC.
# The vibration motor's variant (5), and where the modem's remote-file-system buffer is in its memory map (a number taken from the
# phone's own device tree; tools/soc-args.py makes it for a phone that has another).
CONFIG_DEVICE="redwood"
CONFIG_HAPTIC=5
CONFIG_MODEM_BUFFER=0xa8000000

# the panel runs at 120 Hz (fb_measure=1 counted 120 refreshes a second): frames made at that rate, and CoreAnimation
# clocked by the driver's refresh instead of the 60 Hz timer it keeps on an iPhone X
CONFIG_FB_HZ=120
CONFIG_CA_VBL=1

# the system on the four big cores only (7, 6, 5, 4: the Cortex-A78s at 2.4 GHz), not the three small A55s at 1.8 GHz too.
# The scheduler does not tell them apart, and a window-server frame that lands on a small core takes two to three times as
# long: with all seven, 17% of CoreAnimation's GL frames went past the 8.3 ms of a 120 Hz beat; with these four, 8% (p90 10.3 ->
# 8.2 ms), and Settings scrolled at 107-114 a second, 1-2% of frame steps over 16.7 ms (rc.jobs.scroll, 31 October). Page
# swipes, where several processes draw at once, did not gain. The way to have all seven: the scheduler told which are which.
CONFIG_CPUS=4
